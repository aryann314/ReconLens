    {"name": "PyPI", "category": "Developer", "url": "https://pypi.org/user/{}/", "profile_url": "https://pypi.org/user/{}/", "method": "status_code"},
    {"name": "npm", "category": "Developer", "url": "https://www.npmjs.com/~{}", "profile_url": "https://www.npmjs.com/~{}", "method": "status_code"},
    {"name": "DEV Community", "category": "Developer", "url": "https://dev.to/{}", "profile_url": "https://dev.to/{}", "method": "status_code"},
    {"name": "Hacker News", "category": "Community", "url": "https://hacker-news.firebaseio.com/v0/user/{}.json", "profile_url": "https://news.ycombinator.com/user?id={}", "method": "message", "absent_text": "null", "absent_exact": true},
    {"name": "Reddit", "category": "Social", "url": "https://www.reddit.com/user/{}/about.json", "profile_url": "https://www.reddit.com/user/{}", "method": "status_code"},
