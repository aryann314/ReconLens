{
  "_comment": "Curated platforms for username checks. Detection approach adapted from the open-source Sherlock project. method=status_code: found_codes => exists, not_found_codes => absent. method=message: HTTP 200 + absent_text in body => absent, HTTP 200 without it => exists. Anything else is inconclusive. Platforms that require login or aggressively block automated requests (Instagram, X/Twitter, LinkedIn, Facebook) are intentionally excluded.",
  "sites": [
    {"name": "GitHub", "category": "Developer", "url": "https://github.com/{}", "profile_url": "https://github.com/{}", "method": "status_code"},
    {"name": "GitLab", "category": "Developer", "url": "https://gitlab.com/api/v4/users?username={}", "profile_url": "https://gitlab.com/{}", "method": "message", "absent_text": "[]", "absent_exact": true},
    {"name": "Codeberg", "category": "Developer", "url": "https://codeberg.org/api/v1/users/{}", "profile_url": "https://codeberg.org/{}", "method": "status_code"},
