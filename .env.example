# Optional settings for local development. Copy this file to .env before running.
# Keep real secrets in .env; never commit that file.

SECRET_KEY=
ALLOW_LIVE_MODE=true
AUTHORIZED_EMAIL_DOMAINS=

# Email breach checks use XposedOrNot and do not need an API key.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_AUTH_KEY=

OSINT_USER_AGENT=ReconLens/1.0 (authorised OSINT project)
HTTP_TIMEOUT=10
CRTSH_TIMEOUT=25
DNS_TIMEOUT=5
SCAN_RATE_LIMIT=10 per minute
DEFAULT_RATE_LIMIT=1000 per hour
RETENTION_DAYS=30
